// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String
  active        Boolean        @default(true)
  platformAdmin Boolean        @default(false) @map("platform_admin")
  sessionVersion Int           @default(0) @map("session_version")
  timezone      String         @default("UTC")
  twofaStatus   Boolean        @default(false) @map("twofa_status")
  twofaSecret   String?        @map("twofa_secret")
  createdAt     DateTime       @default(now()) @map("created_at")

  memberships   WorkspaceMember[]
  monitors      Monitor[]
  notifications Notification[]
  apiKeys       ApiKey[]
  sessions      UserSession[]

  @@map("users")
}

model UserSession {
  id         String    @id @default(cuid())
  userId     Int       @map("user_id")
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastActive DateTime  @default(now()) @map("last_active")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastActive])
  @@map("user_sessions")
}

model Monitor {
  originHint String? @map("origin_hint") @db.VarChar(64)
  nextCheckAt DateTime @default(now()) @map("next_check_at") @db.Timestamptz(3)
  runId String? @map("run_id") @db.Uuid
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(3)
  leaseOwner String? @map("lease_owner")
  leaseToken BigInt @default(0) @map("lease_token")
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  claimedConfigVersion Int? @map("claimed_config_version")
  states MonitorState[]
  hourly HeartbeatHourly[]
  historyCheckpoints HistoryCheckpoint[]
  notificationDedupe NotificationDedupe[]
  notificationOutbox NotificationOutbox[]
  configVersion Int @default(1) @map("config_version")
  brunoSources BrunoSource[]
  // FK (group_id, workspace_id) -> monitor_groups is defined in SQL with ON DELETE SET NULL (group_id).
  groupId Int? @map("group_id")
  @@unique([id, workspaceId, environmentId], map: "monitors_id_workspace_environment_key")
  requestSecrets String? @map("request_secrets")
  assertions Json?
  authConfig Json? @map("auth_config")
  environmentId Int @map("environment_id")
  environment Environment @relation(fields: [environmentId, workspaceId], references: [id, workspaceId])
  maintenances MaintenanceMonitor[]
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  active          Boolean   @default(true)
  userId          Int       @map("user_id")
  interval        Int       @default(60)
  retryInterval   Int       @default(60) @map("retry_interval")
  maxretries      Int       @default(0)
  timeout         Int       @default(48)
  responseTimeThreshold Int? @map("response_time_threshold")
  resendInterval  Int       @default(0) @map("resend_interval")
  type            String    // http, tcp, ping, dns, push, docker, keyword, json-query, grpc-keyword, etc.
  url             String?
  hostname        String?
  port            Int?
  method          String    @default("GET")
  body            String?
  headers         Json?
  keyword         String?
  invertKeyword   Boolean   @default(false) @map("invert_keyword")
  ignoreTls       Boolean   @default(false) @map("ignore_tls")
  upsideDown      Boolean   @default(false) @map("upside_down")
  authMethod      String?   @map("auth_method")
  basicAuthUser   String?   @map("basic_auth_user")
  basicAuthPass   String?   @map("basic_auth_pass")
  pushToken       String?   @unique @map("push_token")
  proxyId         Int?      @map("proxy_id")
  weight          Int       @default(1000)
  createdAt       DateTime  @default(now()) @map("created_at")
  
  // HTTP specific
  maxRedirects    Int       @default(10) @map("max_redirects")
  acceptedStatuscodes Json? @map("accepted_statuscodes") // JSON array of accepted status codes
  
  // JSON Query specific
  jsonPath        String?   @map("json_path")
  expectedValue   String?   @map("expected_value")
  
  // gRPC specific
  grpcUrl         String?   @map("grpc_url")
  grpcProtoContent String?  @map("grpc_proto_content")
  grpcMethod      String?   @map("grpc_method")
  grpcServiceName String?   @map("grpc_service_name")
  grpcEnableTls   Boolean   @default(false) @map("grpc_enable_tls")
  grpcBody        String?   @map("grpc_body")
  grpcMetadata    String?   @map("grpc_metadata")
  
  // Database specific
  databaseType    String?   @map("database_type")
  databaseConnectionString String? @map("database_connection_string")
  databaseQuery   String?   @map("database_query")
  
  // Docker specific
  dockerHost      String?   @map("docker_host")
  dockerDaemon    String?   @map("docker_daemon")
  dockerContainer String?   @map("docker_container")
  
  // MQTT specific
  mqttTopic       String?   @map("mqtt_topic")
  mqttUsername    String?   @map("mqtt_username")
  mqttPassword    String?   @map("mqtt_password")
  mqttSuccessMessage String? @map("mqtt_success_message")
  
  // Kafka specific  
  kafkaBrokers    Json?     @map("kafka_brokers")
  kafkaTopic      String?   @map("kafka_topic")
  kafkaSaslMechanism String? @map("kafka_sasl_mechanism")
  kafkaUsername   String?   @map("kafka_username")
  kafkaPassword   String?   @map("kafka_password")
  
  // RabbitMQ specific
  rabbitmqNodes   Json?     @map("rabbitmq_nodes")
  rabbitmqUsername String?  @map("rabbitmq_username")
  rabbitmqPassword String?  @map("rabbitmq_password")
  
  // Redis specific
  redisConnectionString String? @map("redis_connection_string")
  
  // Radius specific
  radiusSecret    String?   @map("radius_secret")
  radiusCalledStationId String? @map("radius_called_station_id")
  radiusCallingStationId String? @map("radius_calling_station_id")

  // SNMP specific
  snmpOid     String?   @map("snmp_oid")
  snmpVersion String?   @default("2c") @map("snmp_version")

  // HTTP request options
  cacheBust   Boolean   @default(false) @map("cache_bust")
  
  // Game server specific
  game            String?
  
  // Group specific
  parent          Int?
  childrenIds     Json?     @map("children_ids")
  
  // Real Browser specific
  remoteBrowserId Int?      @map("remote_browser_id")

  // DNS specific
  dnsRecordType   String?   @map("dns_record_type")
  dnsResolver     String?   @map("dns_resolver")

  // TLS Certificate specific
  expiryNotification Boolean @default(false) @map("expiry_notification")
  tlsExpiryDays     Json?   @map("tls_expiry_days") // JSON array of days before expiry to notify
  tlsInfo           Json?   @map("tls_info") // Cached TLS certificate info

  // Cluster node assignment
  nodeId            String?   @map("node_id") // Default node for this monitor
  assignedNode      String?   @map("assigned_node") // Override node (set when redistributing)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  proxy                Proxy?                @relation(fields: [proxyId], references: [id])
  heartbeats           Heartbeat[]
  tags                 MonitorTag[]
  statusPageMonitors   StatusPageMonitor[]
  monitorNotifications MonitorNotification[]

  @@index([userId])
  @@index([active])
  @@index([nodeId])
  @@index([assignedNode])
  @@map("monitors")
  @@index([workspaceId])
  @@index([workspaceId, environmentId, id])
  @@index([workspaceId, groupId], map: "monitors_workspace_group_idx")
}

model Heartbeat {
  coverageSeconds Int? @map("coverage_seconds")
  runId String? @unique @map("run_id") @db.Uuid
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(3)
  configVersion Int? @map("config_version")
  assertionResults Json? @map("assertion_results")
  checkCode String? @map("check_code")
  id        BigInt   @id @default(autoincrement())
  monitorId Int      @map("monitor_id")
  status    Int      @db.SmallInt // 0: DOWN, 1: UP, 2: PENDING, 3: MAINTENANCE
  time      DateTime @default(now()) @db.Timestamptz
  msg       String?
  ping      Int?
  important Boolean  @default(false)
  duration  Int      @default(0)

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, time(sort: Desc),id(sort: Desc)])
  @@index([time,id])
  @@map("heartbeats")
}

model Notification {
  dedupe NotificationDedupe[]
  outbox NotificationOutbox[]
  @@unique([id,workspaceId],map:"notifications_id_workspace_key")
  resourceSecrets String? @map("resource_secrets")
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id        Int     @id @default(autoincrement())
  name      String
  userId    Int     @map("user_id")
  type      String  // discord, slack, telegram, email, webhook
  config    Json
  isDefault Boolean @default(false) @map("is_default")
  active    Boolean @default(true)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorNotifications MonitorNotification[]

  @@index([userId])
  @@map("notifications")
  @@index([workspaceId])
}

model MonitorNotification {
  monitorId      Int @map("monitor_id")
  notificationId Int @map("notification_id")

  monitor      Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([monitorId, notificationId])
  @@map("monitor_notifications")
}

model StatusPage {
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id                    Int       @id @default(autoincrement())
  slug                  String    @unique
  title                 String
  description           String?
  icon                  String?
  theme                 String    @default("auto")
  published             Boolean   @default(true)
  passwordHash          String?   @map("password_hash")
  showTags              Boolean   @default(false) @map("show_tags")
  showPoweredBy         Boolean   @default(true) @map("show_powered_by")
  showCertificateExpiry Boolean   @default(false) @map("show_certificate_expiry")
  perPage               Int       @default(5) @map("per_page")
  autoRefreshInterval   Int       @default(300) @map("auto_refresh_interval")
  customCss             String?   @map("custom_css")
  footerText            String?   @map("footer_text")
  googleAnalyticsId     String?   @map("google_analytics_id")
  userId                Int       @map("user_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  groups    StatusPageGroup[]
  incidents Incident[]

  @@index([userId])
  @@map("status_pages")
  @@index([workspaceId])
  maintenances MaintenanceStatusPage[]
}

model StatusPageGroup {
  id           Int     @id @default(autoincrement())
  statusPageId Int     @map("status_page_id")
  name         String
  weight       Int     @default(1000)

  statusPage StatusPage          @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitors   StatusPageMonitor[]

  @@map("status_page_groups")
}

model StatusPageMonitor {
  id        Int     @id @default(autoincrement())
  groupId   Int     @map("group_id")
  monitorId Int     @map("monitor_id")
  sendUrl   Boolean @default(false) @map("send_url")

  group   StatusPageGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  monitor Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("status_page_monitors")
}

model Incident {
  id           Int       @id @default(autoincrement())
  statusPageId Int       @map("status_page_id")
  title        String
  content      String
  style        String    @default("warning") // info, warning, danger, primary, light, dark
  pin          Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)

  @@map("incidents")
}

model Tag {
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id     Int    @id @default(autoincrement())
  name   String
  color  String
  userId Int    @map("user_id")

  monitors MonitorTag[]

  @@index([userId])
  @@map("tags")
  @@index([workspaceId])
}

model MonitorTag {
  monitorId Int     @map("monitor_id")
  tagId     Int     @map("tag_id")
  value     String?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([monitorId, tagId])
  @@map("monitor_tags")
}

model Proxy {
  resourceSecrets String? @map("resource_secrets")
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id        Int      @id @default(autoincrement())
  protocol  String   // http, https, socks5
  host      String
  port      Int
  auth      Boolean  @default(false)
  username  String?
  password  String?
  active    Boolean  @default(true)
  isDefault Boolean  @default(false) @map("is_default")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  monitors Monitor[]

  @@index([userId])
  @@map("proxies")
  @@index([workspaceId])
}

model DockerHost {
  resourceSecrets String? @map("resource_secrets")
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id            Int      @id @default(autoincrement())
  name          String
  dockerType    String   @default("socket") @map("docker_type") // socket, tcp
  dockerDaemon  String?  @map("docker_daemon")
  connectionUrl String?  @map("connection_url")
  active        Boolean  @default(true)
  userId        Int      @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("docker_hosts")
  @@index([workspaceId])
}

model Maintenance {
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  strategy       String    @default("manual") // manual, recurring, single, cron
  active         Boolean   @default(true)
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  dateRange      String?   @map("date_range") // JSON string for date ranges
  intervalDay    Int       @default(1) @map("interval_day")
  weekdays       String?   // JSON array of weekdays
  daysOfMonth    String?   @map("days_of_month") // JSON array of days
  timeRange      String?   @map("time_range") // JSON string for time ranges
  cron           String?
  duration       Int       @default(60)
  timezone       String    @default("UTC")
  timezoneOption String?   @map("timezone_option")
  timezoneOffset String?   @map("timezone_offset")
  userId         Int       @map("user_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  monitors    MaintenanceMonitor[]
  statusPages MaintenanceStatusPage[]

  @@index([userId])
  @@map("maintenances")
  @@index([workspaceId])
}

model MaintenanceMonitor {
  id            Int @id @default(autoincrement())
  maintenanceId Int @map("maintenance_id")
  monitorId     Int @map("monitor_id")

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([maintenanceId, monitorId])
  @@map("maintenance_monitors")
}

model MaintenanceStatusPage {
  id            Int @id @default(autoincrement())
  maintenanceId Int @map("maintenance_id")
  statusPageId  Int @map("status_page_id")

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)

  @@unique([maintenanceId, statusPageId])
  @@map("maintenance_status_pages")
}

model ApiKey {
  scope String @default("read")
  environmentId Int? @map("environment_id")
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id        Int       @id @default(autoincrement())
  key       String    @unique
  name      String
  userId    Int       @map("user_id")
  active    Boolean   @default(true)
  expires   DateTime?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
  @@index([workspaceId])
}

model Setting {
  id    Int     @id @default(autoincrement())
  key   String  @unique
  value String?
  type  String  @default("string")

  @@map("settings")
}

model RemoteBrowser {
  resourceSecrets String? @map("resource_secrets")
  workspaceId Int @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  active    Boolean  @default(true)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("remote_browsers")
  @@index([workspaceId])
}

model Node {
  id           Int       @id @default(autoincrement())
  nodeId       String    @unique @map("node_id")
  nodeName     String    @map("node_name")
  host         String?
  hostname     String?
  location     String?
  status       String    @default("unknown") // online, offline, unknown
  active       Boolean   @default(true)
  isPrimary    Boolean   @default(false) @map("is_primary")
  lastSeen     DateTime? @map("last_seen")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  modifiedAt   DateTime  @updatedAt @map("modified_at")

  @@index([nodeId])
  @@index([status])
  @@index([active])
  @@index([isPrimary])
  @@map("nodes")
}


model Workspace {
  id Int @id @default(autoincrement())
  name String
  personalUserId Int? @unique @map("personal_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  members WorkspaceMember[]
  environments Environment[]
  monitors Monitor[]
  notifications Notification[]
  statusPages StatusPage[]
  tags Tag[]
  proxies Proxy[]
  dockerHosts DockerHost[]
  maintenances Maintenance[]
  apiKeys ApiKey[]
  remoteBrowsers RemoteBrowser[]
  monitorGroups MonitorGroup[]
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId Int @map("workspace_id")
  userId Int @map("user_id")
  role String @default("viewer")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Environment {
  id Int @id @default(autoincrement())
  workspaceId Int @map("workspace_id")
  name String
  variables Json @default("{}")
  secrets Json @default("{}")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitors Monitor[]
  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@map("environments")
}

model BrunoSource {
  id Int @id @default(autoincrement())
  workspaceId Int @map("workspace_id")
  environmentId Int @map("environment_id")
  collectionId String @map("collection_id")
  sourceEnvironment String @default("") @map("source_environment")
  path String
  ignoredBlocks String[] @default([]) @map("ignored_blocks")
  monitorId Int @unique @map("monitor_id")
  monitor Monitor @relation(fields:[monitorId,workspaceId,environmentId],references:[id,workspaceId,environmentId],onDelete:Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@unique([workspaceId,environmentId,collectionId,sourceEnvironment,path],map:"bruno_source_identity")
  @@map("bruno_sources")
}


model MonitorGroup {
  id Int @id @default(autoincrement())
  workspaceId Int @map("workspace_id")
  // FK (parent_id, workspace_id) is defined in SQL; parents cascade to their subtree.
  parentId Int? @map("parent_id")
  name String @db.VarChar(150)
  sortOrder Int @default(0) @map("sort_order")
  sourceKind String @default("manual") @map("source_kind") @db.VarChar(16)
  collectionId String? @map("collection_id") @db.VarChar(100)
  sourcePath String? @map("source_path") @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([id, workspaceId], map: "monitor_groups_id_workspace_key")
  @@index([workspaceId, parentId, sortOrder, id], map: "monitor_groups_workspace_parent_idx")
  @@map("monitor_groups")
}
model MonitorState {
  assertionResults Json? @map("assertion_results")
  monitorId Int @id @map("monitor_id")
  workspaceId Int @map("workspace_id")
  environmentId Int @map("environment_id")
  monitor Monitor @relation(fields:[monitorId,workspaceId,environmentId],references:[id,workspaceId,environmentId],onDelete:Cascade)
  heartbeatId BigInt? @map("heartbeat_id")
  runId String? @map("run_id") @db.Uuid
  status Int
  ping Int
  checkCode String @map("check_code")
  checkedAt DateTime @map("checked_at") @db.Timestamptz(3)
  statusChangedAt DateTime @map("status_changed_at") @db.Timestamptz(3)
  revision BigInt @default(1)
  @@index([workspaceId,environmentId,monitorId])
  @@map("monitor_states")
}

model NotificationOutbox {
  dedupeKey String? @unique @map("dedupe_key")
  id BigInt @id @default(autoincrement())
  runId String @map("run_id") @db.Uuid
  eventType String @map("event_type")
  notificationId Int @map("notification_id")
  workspaceId Int @map("workspace_id")
  environmentId Int @map("environment_id")
  monitorId Int @map("monitor_id")
  monitor Monitor @relation(fields:[monitorId,workspaceId,environmentId],references:[id,workspaceId,environmentId],onDelete:Cascade)
  notification Notification @relation(fields:[notificationId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseOwner String? @map("lease_owner")
  leaseToken BigInt @default(0) @map("lease_token")
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  errorCode String? @map("error_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  @@unique([runId,notificationId,eventType])
  @@index([status,nextAttemptAt])
  @@index([leaseUntil])
  @@index([workspaceId,createdAt])
  @@map("notification_outbox")
}

model WorkerInstance {
  instanceId String @id @map("instance_id") @db.Uuid
  role String
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  lastSeen DateTime @default(now()) @map("last_seen") @db.Timestamptz(3)
  draining Boolean @default(false)
  concurrency Int
  inflight Int @default(0)
  metrics Json
  @@index([lastSeen])
  @@map("worker_instances")
}

model HeartbeatHourly {
 monitorId Int @map("monitor_id")
 workspaceId Int @map("workspace_id")
 environmentId Int @map("environment_id")
 monitor Monitor @relation(fields:[monitorId,workspaceId,environmentId],references:[id,workspaceId,environmentId],onDelete:Cascade)
 bucketStart DateTime @map("bucket_start") @db.Timestamptz(3)
 upMs BigInt @map("up_ms")
 downMs BigInt @map("down_ms")
 maintenanceMs BigInt @map("maintenance_ms")
 unknownMs BigInt @map("unknown_ms")
 pingSum BigInt @map("ping_sum")
 pingCount Int @map("ping_count")
 minPing Int? @map("min_ping")
 maxPing Int? @map("max_ping")
