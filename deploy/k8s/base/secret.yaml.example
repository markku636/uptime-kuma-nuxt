# Generate actual values privately. Never apply these placeholders.
apiVersion: v1
kind: Secret
metadata:
  name: uptime-api-secret
  namespace: uptime-api
type: Opaque
stringData:
  DATABASE_URL: REPLACE_WITH_EXTERNAL_POSTGRESQL_URL
  APP_ENCRYPTION_KEY: REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
  NUXT_SESSION_PASSWORD: REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
