meta {
  name: Import settings file
  type: http
  seq: 4
  tags: [
    destructive
  ]
}

post {
  url: {{baseUrl}}/api/v1/settings/import
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file()
}

docs {
  匯入設定

  Upload the JSON file produced by the settings export.

  Requires the session cookie from **Auth / Login**, or the `apiKey` environment secret.

  **Destructive** — excluded from smoke runs.
}
