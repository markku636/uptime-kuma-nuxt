meta {
  name: Update remote browser
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/remote-browsers/:id
  body: json
  auth: none
}

params:path {
  id: {{remoteBrowserId}}
}

body:json {
  {
    "name": "Renamed browser"
  }
}

docs {
  更新遠端瀏覽器

  Requires the session cookie from **Auth / Login**, or the `apiKey` environment secret.
}
