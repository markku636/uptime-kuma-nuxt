meta {
  name: Create remote browser
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/remote-browsers
  body: json
  auth: none
}

body:json {
  {
    "name": "Chrome",
    "url": "ws://localhost:3000"
  }
}

script:post-response {
  const body = res.getBody();
  const value = body?.data?.id ?? body?.id;
  if (value !== undefined && value !== null) {
    bru.setVar("remoteBrowserId", value);
  }
}

docs {
  建立遠端瀏覽器

  Requires the session cookie from **Auth / Login**, or the `apiKey` environment secret.

  Stores the new record in `{{remoteBrowserId}}` for the following requests.
}
