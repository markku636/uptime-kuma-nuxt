meta {
  name: Create tag
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/tags
  body: json
  auth: none
}

body:json {
  {
    "name": "Production",
    "color": "#4CAF50"
  }
}

script:post-response {
  const body = res.getBody();
  const value = body?.data?.id ?? body?.id;
  if (value !== undefined && value !== null) {
    bru.setVar("tagId", value);
  }
}

docs {
  建立標籤

  Requires the session cookie from **Auth / Login**, or the `apiKey` environment secret.

  Stores the new record in `{{tagId}}` for the following requests.
}
