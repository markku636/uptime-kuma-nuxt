meta {
  name: Create maintenance window - cron
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/maintenances
  body: json
  auth: none
}

body:json {
  {
    "title": "Nightly maintenance",
    "strategy": "cron",
    "cron": "0 3 * * *",
    "durationMinutes": 60,
    "dateRange": [
      "2030-01-01 00:00:00",
      "2030-12-31 00:00:00"
    ],
    "timezoneOption": "UTC",
    "monitors": [],
    "statusPages": []
  }
}

script:post-response {
  const body = res.getBody();
  const value = body?.data?.id ?? body?.id;
  if (value !== undefined && value !== null) {
    bru.setVar("maintenanceId", value);
  }
}

docs {
  建立 Cron 維護排程

  Requires the session cookie from **Auth / Login**, or the `apiKey` environment secret.

  Stores the new record in `{{maintenanceId}}` for the following requests.
}
