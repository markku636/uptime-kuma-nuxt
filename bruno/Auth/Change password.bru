meta {
  name: Change password
  type: http
  seq: 7
  tags: [
    destructive
  ]
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "new-password"
  }
}

docs {
  變更密碼

  Requires the session cookie from **Auth / Login** (API keys are not accepted here).

  **Destructive** — excluded from smoke runs.
}
