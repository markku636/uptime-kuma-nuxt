meta {
  name: Create monitor - JSON path
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/monitors
  body: json
  auth: none
}

body:json {
  {
    "name": "JSON path monitor",
    "type": "http",
    "url": "https://httpbin.org/json",
    "method": "GET",
    "interval": 60,
    "retryInterval": 30,
    "timeout": 10,
    "jsonPath": "$.slideshow.title",
    "expectedValue": "Sample Slideshow"
  }
}

script:post-response {
  const body = res.getBody();
  const value = body?.data?.id ?? body?.id;
  if (value !== undefined && value !== null) {
    bru.setVar("monitorId", value);
  }
}

docs {
  建立 HTTP 監控器 (JSON Path 檢查)

  Requires the session cookie from **Auth / Login**, or the `apiKey` environment secret.

  Stores the new record in `{{monitorId}}` for the following requests.
}
