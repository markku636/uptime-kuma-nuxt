meta {
  name: Create monitor
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/monitors
  body: json
  auth: none
}

body:json {
  {
    "name": "Example HTTP monitor",
    "type": "http",
    "url": "https://httpbin.org/status/200",
    "method": "GET",
    "interval": 60,
    "retryInterval": 30,
    "timeout": 10,
    "maxretries": 0,
    "active": true,
    "description": "Created from the API",
    "headers": {
      "User-Agent": "Kuma-Monitor"
    }
  }
}

script:post-response {
  const body = res.getBody();
  const value = body?.data?.id ?? body?.id;
  if (value !== undefined && value !== null) {
    bru.setVar("monitorId", value);
  }
}

docs {
  建立監控器

  Requires the session cookie from **Auth / Login**, or the `apiKey` environment secret.

  Stores the new record in `{{monitorId}}` for the following requests.
}
