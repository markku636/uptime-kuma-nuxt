meta {
  name: Update API key
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/api-keys/:id
  body: json
  auth: none
}

params:path {
  id: {{apiKeyId}}
}

body:json {
  {
    "name": "Renamed API key",
    "active": true
  }
}

docs {
  更新 API Key

  Requires the session cookie from **Auth / Login** (API keys are not accepted here).
}
