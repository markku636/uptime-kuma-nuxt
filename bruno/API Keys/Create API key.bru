meta {
  name: Create API key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/api-keys
  body: json
  auth: none
}

body:json {
  {
    "name": "External API access",
    "expires": "2030-12-31T23:59:59Z"
  }
}

script:post-response {
  const body = res.getBody();
  const value = body?.data?.id ?? body?.id;
  if (value !== undefined && value !== null) {
    bru.setVar("apiKeyId", value);
  }
}

docs {
  建立 API Key

  Requires the session cookie from **Auth / Login** (API keys are not accepted here).

  Stores the new record in `{{apiKeyId}}` for the following requests.
}
