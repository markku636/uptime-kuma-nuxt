# Database
DATABASE_URL="postgresql://user:password@localhost:5432/uptime_kuma?schema=public"

# JWT Secret
JWT_SECRET="your-secret-key-change-this-in-production"

# App URL
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Required in production; generate a unique value (at least 32 characters).
NUXT_SESSION_PASSWORD=""
# Required at production startup for monitor requests and environment secrets. Keep with encrypted backups.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=""
# Rate limits per minute; trust forwarded IP headers only behind a trusted ingress.
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=20
TRUST_PROXY_HEADERS=false

# api serves REST/WebSocket; worker serves probes only; all keeps single-process use.
APP_ROLE=all
DB_POOL_SIZE=6
WORKER_DB_POOL_SIZE=3
WORKER_CONCURRENCY=32
WORKER_PER_ORIGIN=8
WORKER_CLAIM_BATCH=8
WORKER_POLL_MS=250
WORKER_LEASE_MS=15000
WORKER_RENEW_MS=3000
WORKER_RUN_TIMEOUT_MS=120000
WORKER_DRAIN_MS=15000
NOTIFICATION_CONCURRENCY=4
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_MS=1000
NOTIFICATION_TIMEOUT_MS=10000

# Comma-separated exact additional browser origins, no wildcards.
APP_ALLOWED_ORIGINS=

# Worker-only hourly history maintenance. Deletion is explicitly opt-in.
HEARTBEAT_RETENTION_ENABLED=false
HEARTBEAT_RAW_HOURS=48
HEARTBEAT_HOURLY_DAYS=400
